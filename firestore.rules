rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
                                    && request.auth.uid == userId;

      match /courseEnrollments/{courseId} {
        allow read, create, update, delete: if signedIn()
                                            && request.auth.uid == userId;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn()
                  && (resource.data.status == 'published'
                      || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && (resource.data.userId == request.auth.uid
                        || request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['likedBy', 'likeCount', 'commentCount']));
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.userId == request.auth.uid;
        allow update, delete: if signedIn()
                              && resource.data.userId == request.auth.uid;
      }
    }

    match /courses/{courseId} {
      allow read: if signedIn()
                  && (resource.data.status == 'published'
                      || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && (resource.data.userId == request.auth.uid
                        || request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['enrollmentCount']));
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.admins
                    && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
                    && (request.auth.uid in resource.data.members
                        || request.auth.uid in resource.data.admins
                        || (!(request.auth.uid in resource.data.members)
                            && request.auth.uid in request.resource.data.members));
      allow delete: if signedIn()
                    && (request.auth.uid in resource.data.admins
                        || (request.auth.uid in resource.data.members
                            && resource.data.members.size() == 1));

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/groups/$(groupId))
                       .data.members;
        allow create: if signedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/groups/$(groupId))
                         .data.members
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn()
                      && resource.data.senderId == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasAll([
                      'userId', 'type', 'title', 'message', 'groupId',
                      'groupName', 'isRead', 'createdAt'
                    ])
                    && request.resource.data.isRead == false
                    && request.resource.data.type in [
                      'member_joined', 'admin_changed', 'group_deleted'
                    ]
                    && exists(
                      /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                    )
                    && ((request.resource.data.type == 'member_joined'
                         && request.auth.uid in get(
                           /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                         ).data.members
                         && request.resource.data.userId in get(
                           /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                         ).data.admins)
                        || (request.resource.data.type == 'admin_changed'
                            && request.auth.uid in get(
                              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                            ).data.admins
                            && request.resource.data.userId in get(
                              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                            ).data.admins)
                        || (request.resource.data.type == 'group_deleted'
                            && request.auth.uid in get(
                              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                            ).data.admins
                            && request.resource.data.userId in get(
                              /databases/$(database)/documents/groups/$(request.resource.data.groupId)
                            ).data.members));
      allow read: if signedIn()
                  && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['isRead']);
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }

    match /skill_requests/{skillId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    match /skill_offers/{bookingId} {
      allow read: if signedIn()
                  && (resource.data.senderId == request.auth.uid
                      || resource.data.recipientId == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && exists(
                      /databases/$(database)/documents/skill_requests/$(request.resource.data.requestId)
                    )
                    && get(
                      /databases/$(database)/documents/skill_requests/$(request.resource.data.requestId)
                    ).data.ownerId == request.resource.data.recipientId;

      allow update: if signedIn()
                    && resource.data.recipientId == request.auth.uid
                    && resource.data.senderId != request.auth.uid
                    && request.resource.data.senderId == resource.data.senderId
                    && request.resource.data.recipientId == resource.data.recipientId
                    && request.resource.data.requestId == resource.data.requestId
                    && ((resource.data.status == 'pending'
                         && request.resource.data.status == 'accepted'
                         && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly([
                             'status', 'scheduledDate', 'scheduledTime',
                             'meetingPlatform', 'meetingLink', 'acceptedAt'
                           ]))
                        || (resource.data.status == 'pending'
                            && request.resource.data.status == 'rejected'
                            && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'status', 'scheduledDate', 'scheduledTime',
                                'meetingPlatform', 'meetingLink', 'rejectedAt'
                              ]))
                        || (resource.data.status == 'accepted'
                            && request.resource.data.status == 'accepted'
                            && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'meetingPlatform', 'meetingLink',
                                'linkPublishedAt'
                              ])));

      allow delete: if signedIn()
                    && resource.data.senderId == request.auth.uid
                    && resource.data.status == 'pending';
    }
  }
}
